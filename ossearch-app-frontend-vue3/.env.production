# Production builds use relative API URLs (empty base) so a single identical
# build can be deployed to every application server behind the load balancer.
# Each server's Apache vhost proxies /api, /actuator, and /search to its own
# local backend. Baking a hostname in here produces different webpack content
# hashes per server, which causes intermittent blank pages / "Unexpected
# token '<'" errors when the load balancer mixes index.html and JS chunks
# from different servers.
VUE_APP_API_BASE_URL=

# Only set an absolute base URL for one-off builds targeting a specific server:
#VUE_APP_API_BASE_URL=http://localhost:8484
#VUE_APP_API_BASE_URL=https://si-prodsearch01.si.edu
#VUE_APP_API_BASE_URL=https://si-vmprodsearch02.si.edu
